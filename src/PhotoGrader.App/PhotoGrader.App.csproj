<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PhotoGrader.Core\PhotoGrader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoGrader.App</RootNamespace>
    <!-- 可执行文件图标（由 tools/IconGen 生成） -->
    <ApplicationIcon>PhotoGrader.ico</ApplicationIcon>
    <!-- 不把第三方程序集的 XML 文档注释拷到输出/发布目录。
         WebView2 会带 3 个 .xml 进来，单文件发布时它们会散落在 exe 旁边。 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!-- 版本信息。会写进 exe 的文件属性，发布时与 tag 保持一致 -->
    <Version>1.0.0</Version>
    <Product>PhotoGrader</Product>
    <Description>本地优先的 PNG 图片筛选与重复清理工具</Description>
    <Authors>Huaneg</Authors>
    <Copyright>Copyright (c) 2026 Huaneg</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发期：前端资源照常拷到输出目录，改完样式刷新即可生效。
         发布期：不拷到发布目录 —— 单文件发布要的是一颗干净的 exe。
         同时内嵌进程序集，单文件模式下由内存直接提供（磁盘优先，找不到才用内嵌）。 -->
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标需要作为资源嵌入；preview.png 只是给眼睛看的，不打包 -->
    <Resource Include="PhotoGrader.ico" />
  </ItemGroup>

</Project>
