<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PhotoGrader.Core\PhotoGrader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoGrader.App</RootNamespace>
    <!-- 可执行文件图标（由 tools/IconGen 生成） -->
    <ApplicationIcon>PhotoGrader.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标需要作为资源嵌入；preview.png 只是给眼睛看的，不打包 -->
    <Resource Include="PhotoGrader.ico" />
  </ItemGroup>

</Project>
